import os
import telebot
from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton

# جلب توكن البوت من متغيرات البيئة تلقائياً
TOKEN = os.environ.get('TOKEN') or os.environ.get('BOT_TOKEN') or os.environ.get('TELEGRAM_BOT_TOKEN')

bot = telebot.TeleBot(TOKEN)

# 1. التفاعل مع أمر البداية /start و /help
@bot.message_handler(commands=['start', 'help'])
def send_welcome(message):
    welcome_text = (
        "مرحباً بك في بوت أكاديمية سمو الأرقام (SMU) 📊✨\n\n"
        "الوجهة الاحترافية للتحليل المالي والإشارات الذهبية.\n"
        "يرجى إرسال رمز أو اسم الشركة للحصول على التحليل، أو اختيار أحد الخيارات أدناه:"
    )
    
    markup = InlineKeyboardMarkup()
    btn_saudi = InlineKeyboardButton(text="🇸🇦 قناة السوق السعودي", url="https://t.me/SumouAlArqam")
    btn_us = InlineKeyboardButton(text="🇺🇸 قناة السوق الأمريكي", url="https://t.me/SumouAlArqam")
    btn_website = InlineKeyboardButton(text="🌐 موقع أكاديمية سمو الأرقام", url="https://sumoualarqam.com")
    
    markup.add(btn_saudi)
    markup.add(btn_us)
    markup.add(btn_website)
    
    bot.reply_to(message, welcome_text, reply_markup=markup)

# 2. التفاعل عند إرسال أي رمز شركة أو نص من قبل المستخدم
@bot.message_handler(func=lambda message: True)
def handle_stock_query(message):
    user_query = message.text.strip().upper()
    
    response_text = (
        f"🔍 **أكاديمية سمو الأرقام (SMU)**\n\n"
        f"تم استقبال طلب التحليل للرمز: **{user_query}**\n\n"
        f"⏳ جاري فحص المستويات الفنية والإشارات الخاصة بالشركة...\n"
        f"للمزيد من التحديثات المباشرة والإشارات، تفضل بزيارة قنواتنا الرسمية عبر الأزرار أدناه."
    )
    
    markup = InlineKeyboardMarkup()
    btn_saudi = InlineKeyboardButton(text="🇸🇦 قناة السوق السعودي", url="https://t.me/SumouAlArqam")
    btn_us = InlineKeyboardButton(text="🇺🇸 قناة السوق الأمريكي", url="https://t.me/SumouAlArqam")
    
    markup.add(btn_saudi, btn_us)
    
    bot.reply_to(message, response_text, parse_mode='Markdown', reply_markup=markup)

if __name__ == '__main__':
    bot.infinity_polling()
